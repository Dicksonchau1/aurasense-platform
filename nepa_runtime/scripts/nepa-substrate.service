[Unit]
Description=NEPA Substrate HTTP Server (PR D-4)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jetson
WorkingDirectory=/home/jetson/aurasense-platform/nepa_runtime
Environment=NEPA_SUBSTRATE_PORT=8080
Environment=NEPA_SUBSTRATE_HOST=0.0.0.0
ExecStart=/home/jetson/aurasense-platform/nepa_runtime/scripts/run_substrate.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
